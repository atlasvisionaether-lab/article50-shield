# Article50 Shield — environment variables
# Copy to .env.local for development. Never commit real values.

# --- Supabase (required for keys, usage logs, audit trail) ---
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Internal API (required for /api/internal/validate) ---
# Shared secret for service-to-service calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# --- Optional ---
# NEXT_PUBLIC_APP_URL=https://article50.shield.example.com
